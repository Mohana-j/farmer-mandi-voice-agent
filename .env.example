# Farmer Mandi Price Voice Agent - Environment Configuration

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./mandi_agent.db

# Data Provider Configuration
# Set to 'live' to attempt official public agricultural market API / portal retrieval
# Set to 'synthetic' to use verified deterministic fixtures for demo and offline testing
DATA_PROVIDER_MODE=synthetic

# Official Public Mandi Portal Configuration (e.g., Agmarknet / eNAM public data portal)
LIVE_PORTAL_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
LIVE_PORTAL_API_KEY=your_gov_data_api_key_here
LIVE_PORTAL_TIMEOUT_SECONDS=10

# AI / LLM Configuration
# Optional: Provide Google Gemini API Key for dynamic natural language reasoning
# If omitted or invalid, the agent operates in transparent deterministic fallback mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Voice & Export Settings
DEFAULT_LANGUAGE=en
EXPORT_DIRECTORY=./exports
