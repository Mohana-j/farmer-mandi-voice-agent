# ==============================================================================
# Farmer Mandi Price Voice Agent - Environment Configuration
# Use placeholders only in this file. NEVER commit actual API keys or secrets.
# ==============================================================================

# --- Backend Server (Render / Local) ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
PYTHONPATH=.

# Database Connection:
# For SQLite on Render (with persistent disk attached at /var/data): sqlite:////var/data/mandi_agent.db
# For SQLite local: sqlite:///./mandi_agent.db
# For PostgreSQL on Render / Supabase / Neon: postgresql://user:password@hostname:5432/mandi_db
DATABASE_URL=sqlite:///./mandi_agent.db

# CORS Allowed Origins:
# Use "*" to allow all origins, or comma-separated list:
# e.g.: https://your-project.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# File Exports Destination Directory
EXPORT_DIRECTORY=./exports

# --- Data Provider Mode ---
# 'synthetic': Uses verified, deterministic offline fixtures (Recommended default for demo & hackathon jury)
# 'live': Connects to official Open Government Data Platform / Agmarknet API
DATA_PROVIDER_MODE=synthetic

# --- Official Public Mandi Portal (Agmarknet / Open Government Data Platform) ---
# Register for a free API key at: https://data.gov.in
LIVE_PORTAL_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
LIVE_PORTAL_API_KEY=your_registered_gov_api_key_here
LIVE_PORTAL_TIMEOUT_SECONDS=8

# --- AI / LLM Configuration (Google Gemini) ---
# Optional: Provide Google Gemini API Key for natural language understanding
# If omitted or invalid, the agent operates in transparent deterministic fallback mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Frontend Client Configuration (Vercel) ---
# On Vercel, set this environment variable to your deployed Render backend URL:
# e.g., VITE_API_URL=https://farmer-mandi-agent.onrender.com
# For local development with Vite dev server proxy, leave empty.
VITE_API_URL=
